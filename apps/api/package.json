    "@fastify/multipart": "^10.1.1",
    "@fastify/static": "^10.1.4",
    "drizzle-orm": "^0.36.4",
    "fastify": "^5.1.0",
    "postgres": "^3.4.5",
    "zod": "^3.23.8",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.0",
    "typescript": "^5.6.3"
  }
