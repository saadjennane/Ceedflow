{
  "name": "ceed",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@ceed/api & npm run dev --workspace=@ceed/web",
    "dev:api": "npm run dev --workspace=@ceed/api",
    "dev:web": "npm run dev --workspace=@ceed/web",
    "build": "npm run build -w @ceed/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "migrate": "npm run migrate -w apps/api",
    "start": "npm run start -w apps/api",
    "export": "npm run export -w apps/api",
    "import": "npm run import -w apps/api --",
    "test": "npm run test -w apps/api"
  }
}
